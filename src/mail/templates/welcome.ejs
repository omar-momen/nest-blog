<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Welcome</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #f4f6f9;
        color: #1a1a2e;
        line-height: 1.6;
        padding: 32px 16px;
      }
      .wrapper {
        max-width: 560px;
        margin: 0 auto;
      }
      .card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        padding: 40px 32px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      .header p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 15px;
        margin-top: 8px;
      }
      .body {
        padding: 36px 32px;
      }
      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 16px;
      }
      .body p {
        font-size: 15px;
        color: #4a4a68;
        margin-bottom: 16px;
      }
      .footer {
        padding: 24px 32px;
        background: #f8f9fc;
        border-top: 1px solid #e8ecf4;
        text-align: center;
      }
      .footer p {
        font-size: 13px;
        color: #8b8ba7;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <h1>Welcome aboard!</h1>
          <p>We're glad you're here.</p>
        </div>
        <div class="body">
          <p class="greeting">Hi <%= name %>,</p>
          <p>
            Thanks for joining us. Your account is ready — explore posts, share your ideas, and connect with the community.
          </p>
        </div>
        <div class="footer">
          <p>You received this email because you signed up on our website.</p>
        </div>
      </div>
    </div>
  </body>
</html>
